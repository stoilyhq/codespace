# urepo <dir> <committed devcontainer.json file or ""> <owner>: a fresh org repo with that file committed + pushed
urepo() {
  rm -rf "$1" "$1-origin.git"; git init -q --bare "$1-origin.git"; git init -q -b main "$1"; git -C "$1" remote add origin "$1-origin.git"
  mkdir -p "$1/.devcontainer"; printf '{"org":"%s","owner":"%s"}\n' "$ORG" "$3" > "$1/.devcontainer/stoily.json"
  [ -z "$2" ] || cp "$2" "$1/.devcontainer/devcontainer.json"
  git -C "$1" add -A && git -C "$1" commit -qm base && git -C "$1" push -q origin HEAD:main
}
pushed() { [ "$(git --git-dir="$1-origin.git" rev-parse main)" = "$(git -C "$1" rev-parse HEAD)" ] && git --git-dir="$1-origin.git" log -1 --format=%s main; }
# compare says the committed commit and the new one DIVERGED (a force-push upstream) → go on
U3="$T/upd3"; printf '{"org":"%s","owner":"d1"}' "$ORG" > "$T/d1.json"; node "$RJ" --source "$SHA_B" "$tpl" "$T/d1.json" "$T/d-b.json"
urepo "$U3" "$T/d-b.json" d2; node "$RJ" --source "$SHA_C" "$tpl" "$U3/.devcontainer/stoily.json" "$U3/.devcontainer/devcontainer.json"
cmpmode ok '{"status":"diverged"}'; out="$(UDIR="$U3" USHA="$SHA_C" upd 0)"; rc=$?
is "compare: diverged → committed and pushed" "$rc $(pushed "$U3")" "0 chore: render stoilyhq/codespace@$SHA_C + stoily.json into .devcontainer/devcontainer.json"
has "…after asking the compare" "$(cat "$T/curl.log")" "compare/$SHA_C...$SHA_B"
# the same stoilyhq commit (a stoily.json edit re-rendered): no compare call, committed
U4="$T/upd4"; printf '{"org":"%s","owner":"s1"}' "$ORG" > "$T/s1.json"; node "$RJ" --source "$SHA_C" "$tpl" "$T/s1.json" "$T/s-c.json"
urepo "$U4" "$T/s-c.json" s2; node "$RJ" --source "$SHA_C" "$tpl" "$U4/.devcontainer/stoily.json" "$U4/.devcontainer/devcontainer.json"
cmpmode http:500; out="$(UDIR="$U4" USHA="$SHA_C" upd 0)"; rc=$?
is "the committed render's own commit again (a stoily.json edit) → no compare call, committed and pushed" "$rc $(grep -c 'compare/' "$T/curl.log") $(pushed "$U4" | cut -c1-13)" "0 0 chore: render"
# an org coming from kit 1: its committed devcontainer.json is the kit-1 file (comments, no GENERATED line)
cat > "$T/kit1-devcontainer.json" <<'KIT1'
{
  // Your org's Stoily Codespace. Everything else (Codex, its locked config, the rules, the programs
  // go/work/save/sync/new-client/check) comes from the stoily Feature, pulled again on every
  // Codespace creation and every Rebuild container: ":1" = the newest 1.x, never a breaking change.
  // See https://github.com/stoilyhq/codespace
  "name": "Stoily Codespace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/stoilyhq/codespace/stoily:1": {
      // "org": "",            empty = the owner of this repo (set it only if your client repos live elsewhere)
      // "clientPrefix": "client-",   client repos are <org>/client-<name>
      "owner": "",             // your GitHub login: your terminals keep a plain shell; every other account's go straight into Codex
      "maxHours": ""           // soft daily cap (hours) for those staff terminals; "" = none
    }
  },
  // The smallest Codespace (2 cores / 8 GB): Codex + tmux need no more.
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "customizations": {
    "codespaces": {
      // Write access to your org's repos (the client repos). GitHub reads this before the container
      // exists, so it cannot come from the Feature: replace YOUR-ORG with your org, exactly once.
      "repositories": {
        "YOUR-ORG/*": { "permissions": { "contents": "write" } }
      }
    }
  }
}
KIT1
