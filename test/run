  cmpmode "$mode" "$body"; out="$(USHA="$SHA_A" upd 0)"; rc=$?
  if [ "$rc" != 0 ] && [[ "$out" == *"::error::"*"compare"* ]] && [ "$(git -C "$UR" rev-parse HEAD)" = "$hS" ]; then ok "$why → an error, a red step, nothing committed"
  else no "$why → rc $rc, out: $(head -c 200 <<<"$out")"; fi
